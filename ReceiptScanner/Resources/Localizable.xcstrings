    "One row per receipt with date, merchant, tax ID, base, VAT and total. Opens in Excel and Numbers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fila por ticket con fecha, comercio, NIF, base, IVA y total. Se abre en Excel y Numbers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une ligne par ticket avec date, commerçant, n° de TVA, base, TVA et total. S’ouvre dans Excel et Numbers."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Zeile pro Beleg mit Datum, Händler, Steuernummer, Netto, MwSt. und Gesamtbetrag. Öffnet sich in Excel und Numbers."
          }
        }
      }
    },
