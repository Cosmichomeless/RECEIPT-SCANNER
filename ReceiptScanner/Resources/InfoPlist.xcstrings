        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receipt Scanner utilise l’appareil photo pour scanner les tickets papier. Les images sont traitées sur votre appareil et ne sont jamais envoyées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receipt Scanner verwendet die Kamera, um Papierbelege zu scannen. Bilder werden auf deinem Gerät verarbeitet und nie hochgeladen."
